[Unit]
Description=Brain Browser History Synchronizer (Zen, Chrome, Chromium to ClickHouse)
Documentation=https://github.com/gustawdaniel/brain
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/.local/bin/browser_sync.py
StandardOutput=journal
StandardError=journal
Nice=19
CPUSchedulingPolicy=idle

[Install]
WantedBy=default.target
